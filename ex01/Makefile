# **************************************************************************** #
#                               configuration                                  #
# **************************************************************************** #

CC		= c++
CFLAGS	= -Wall -Wextra -Werror -I$(INC_DIR) -std=c++98
RM		= rm -rf

# **************************************************************************** #
#                                directories                                   #
# **************************************************************************** #

SRC_DIR	= src/
OBJ_DIR	= obj/
INC_DIR	= include

# **************************************************************************** #
#                                   files                                      #
# **************************************************************************** #

NAME	= zombie
SRC		= $(shell find $(SRC_DIR) -name '*.cpp')
OBJ		= $(patsubst $(SRC_DIR)%, $(OBJ_DIR)%, $(SRC:.cpp=.o))
HEADERS	= $(shell find $(INC_DIR) -name '*.hpp')

# **************************************************************************** #
#                              compile commands                                #
# **************************************************************************** #

COMP		= $(CC) $(CFLAGS) $(OBJ) -o $(NAME)
COMP_OBJ	= $(CC) $(CFLAGS) -c $< -o $@

# **************************************************************************** #
#                                  targets                                     #
# **************************************************************************** #

all: $(NAME)
	@echo "compilation completed."

$(OBJ_DIR)%.o: $(SRC_DIR)%.cpp $(HEADERS)
	@mkdir -p $(dir $@)
	@$(COMP_OBJ)

$(NAME): $(OBJ)
	@$(COMP)

clean:
	@$(RM) $(OBJ_DIR)

fclean: clean
	@$(RM) $(NAME)

re: fclean all

.PHONY: all clean fclean re
